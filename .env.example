Email__FromName=SukoonDesk Support
Storage__Provider=S3
Storage__ServiceUrl=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
Storage__AccessKey=replace-with-r2-access-key
Storage__SecretKey=replace-with-r2-secret-key
Storage__Bucket=sukoondesk-uploads
PlatformAdmin__Emails__0=owner@example.com
