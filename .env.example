Database__Provider=Postgres
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=sukoondesk;Username=sukoondesk;Password=change-this-password
Cors__AllowedOrigins__0=http://localhost:5173
ASPNETCORE_ENVIRONMENT=Production
Email__Provider=Brevo
Email__ApiKey=replace-with-brevo-api-key
